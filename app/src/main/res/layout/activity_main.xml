<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.speakpic.app.GridOverlayView
        android:id="@+id/gridOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <View
        android:id="@+id/focusRing"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:alpha="0"
        android:background="@drawable/focus_ring" />

    <View
        android:id="@+id/flashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#FFFFFF" />

    <!-- Tüm düğmeler bu katmanda; sistem çubukları kadar iç boşluk kodla verilir -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false">

        <TextClock
            android:id="@+id/clockText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:format12Hour="@string/clock_format"
            android:format24Hour="@string/clock_format"
            android:shadowColor="#000000"
            android:shadowRadius="6"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Üst sağ: dil + flaş + HDR -->
        <LinearLayout
            android:id="@+id/topPill"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/pill_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/languageButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/language_title"
                android:padding="9dp"
                android:src="@drawable/ic_language" />

            <ImageButton
                android:id="@+id/flashButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/flash_title"
                android:padding="9dp"
                android:src="@drawable/ic_flash_off" />

            <TextView
                android:id="@+id/hdrButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:padding="6dp"
                android:text="@string/hdr_label"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Sol orta: ızgara -->
        <LinearLayout
            android:id="@+id/gridColumn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/gridButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/pill_bg"
                android:contentDescription="@string/grid_label"
                android:padding="12dp"
                android:src="@drawable/ic_grid" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:shadowColor="#000000"
                android:shadowRadius="4"
                android:text="@string/grid_label"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Sağ orta: dikey yakınlaştırma çubuğu -->
        <FrameLayout
            android:id="@+id/zoomContainer"
            android:layout_width="48dp"
            android:layout_height="220dp"
            android:layout_marginEnd="8dp"
            android:clipChildren="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <SeekBar
                android:id="@+id/zoomSlider"
                android:layout_width="220dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:layoutDirection="ltr"
                android:max="100"
                android:rotation="270" />
        </FrameLayout>

        <!-- Alt satır -->
        <ImageView
            android:id="@+id/thumb"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/thumb_bg"
            android:clipToOutline="true"
            android:contentDescription="@string/gallery_title"
            android:padding="2dp"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <View
            android:id="@+id/shutterButton"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/shutter_bg"
            android:clickable="true"
            android:contentDescription="@string/take_photo"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageButton
            android:id="@+id/galleryButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="28dp"
            android:background="@drawable/pill_bg"
            android:contentDescription="@string/gallery_title"
            android:padding="14dp"
            android:src="@drawable/ic_gallery"
            app:layout_constraintBottom_toBottomOf="@id/shutterButton"
            app:layout_constraintEnd_toStartOf="@id/shutterButton"
            app:layout_constraintTop_toTopOf="@id/shutterButton" />

        <ImageButton
            android:id="@+id/switchButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="28dp"
            android:background="@drawable/pill_bg"
            android:contentDescription="@string/switch_camera"
            android:padding="14dp"
            android:src="@drawable/ic_switch"
            app:layout_constraintBottom_toBottomOf="@id/shutterButton"
            app:layout_constraintStart_toEndOf="@id/shutterButton"
            app:layout_constraintTop_toTopOf="@id/shutterButton" />

        <!-- Fotoğraf çekildikten sonra çıkan mikrofon -->
        <ImageButton
            android:id="@+id/micButton"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_marginBottom="28dp"
            android:background="@drawable/mic_bg"
            android:contentDescription="@string/action_add_voice"
            android:padding="18dp"
            android:src="@drawable/ic_mic"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/shutterButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Bilgi paneli -->
        <LinearLayout
            android:id="@+id/infoPanel"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="76dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/panel_bg"
            android:clipToOutline="true"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="44dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:letterSpacing="0.1"
                    android:text="@string/panel_title"
                    android:textColor="#111111"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/panelClose"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center_vertical|end"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_cancel"
                    android:padding="10dp"
                    android:src="@drawable/ic_close"
                    android:tint="#444444" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabMeta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="@string/tab_meta"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabNote"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="@string/tab_note"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="210dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/metaText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/no_photo_yet"
                        android:textColor="#222222"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/noteGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/recRow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <View
                                android:id="@+id/recDot"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:background="@drawable/rec_dot" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="@string/rec_label"
                                android:textColor="#000000"
                                android:textSize="28sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/noteText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/note_hint"
                            android:lineSpacingExtra="3dp"
                            android:textColor="#111111"
                            android:textSize="13sp" />
                    </LinearLayout>
                </FrameLayout>
            </ScrollView>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
